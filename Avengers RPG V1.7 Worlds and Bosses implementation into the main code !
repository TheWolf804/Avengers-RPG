#include <raylib.h>
#include <raymath.h>   // For Vector2 helper functions
#include <stdlib.h>
#include <stdio.h>
#include <math.h>
#include <time.h>

typedef enum State {
    GameState,
    Dead,
    Menu,
    Settings,
    Submenu,
    Back,
    Paused
} State;

typedef enum Difficulty {
    Practise,
    Easy,
    Normal,
    Hard,
    Insane,
    Nightmare,
    Deathwish,
    Armagedon
} Difficulty;

typedef struct GameData {
    int health;
    float playerSpeed;
    float enemySpeed;
    float enemyVelocity;
    float bombInterval;
    float bombTimer;
    float appleTotal;
    float enemyTotal;
} GameData;

#define MAX_BOMBS 0xFF
#define MAX_APPLES 0xFF
#define MAX_ENEMIES 0xFF
#define MAX_WORLDS 8

typedef struct Bomb {
    float x[MAX_BOMBS], y[MAX_BOMBS];
    int number;
    bool used[MAX_BOMBS];
} Bomb;

typedef struct Apple {
    float x[MAX_APPLES], y[MAX_APPLES];
    int number;
    bool used[MAX_APPLES];
} Apple;

typedef struct Enemy {
    int x[MAX_ENEMIES], y[MAX_ENEMIES];
    int number;
} Enemy;

typedef struct World {
    int id;
    Texture2D background;
    int enemyCount;
    bool bossFightStarted;
} World;

typedef struct Boss {
    Vector2 pos;
    int health;
    bool isActive;
    float speed;
    Texture2D sprite;
} Boss;

// Globals
State state = Menu;
Difficulty diff = Practise;

GameData game;
Apple apples;
Bomb bombs;
Enemy enemies;

float windowX = 800, windowY = 600;
int numberOfCircles = 0;

Sound click, eat, hurt, explosion;
Texture2D plank, brick, grass, apple, bomb;
Texture2D bg;
Texture2D fruit;
Music music;

World worlds[MAX_WORLDS];
int currentWorld = 0;
Boss boss;

// Helper functions
float sigmoid(float x) {
    return 1.0f / (1 + expf(-x));
}

void difficultySelector(Difficulty diff) {
    // Customize game parameters per difficulty here
    switch (diff) {
        case Practise:
            game.health = 10;
            game.playerSpeed = 200.0f;
            game.enemySpeed = 60.0f;
            break;
        case Easy:
            game.health = 8;
            game.playerSpeed = 180.0f;
            game.enemySpeed = 80.0f;
            break;
        // Add other cases as needed
        default:
            game.health = 5;
            game.playerSpeed = 150.0f;
            game.enemySpeed = 100.0f;
            break;
    }
}

void LoadWorld(int id) {
    currentWorld = id;

    // Unload previous background if loaded
    if (bg.id > 0) UnloadTexture(bg);

    switch (id) {
        case 0:
            bg = LoadTexture("world0_bg.png");
            game.enemyTotal = 3;
            game.appleTotal = 5;
            break;
        default:
            bg = LoadTexture("default_bg.png");
            game.enemyTotal = 4;
            game.appleTotal = 3;
            break;
    }

    enemies.number = (int)game.enemyTotal;
    for (int i = 0; i < enemies.number; i++) {
        enemies.x[i] = GetRandomValue(0, (int)windowX);
        enemies.y[i] = GetRandomValue(0, (int)windowY);
    }

    apples.number = (int)game.appleTotal;
    for (int i = 0; i < apples.number; i++) {
        apples.x[i] = GetRandomValue(0, (int)windowX);
        apples.y[i] = GetRandomValue(0, (int)windowY);
        apples.used[i] = false;
    }

    bombs.number = 0;
    for (int i = 0; i < MAX_BOMBS; i++) bombs.used[i] = false;

    boss.isActive = false;

    printf("World %d loaded\n", id);
}

void InitBoss() {
    if (boss.sprite.id > 0) UnloadTexture(boss.sprite); // unload old boss sprite if any

    boss.pos = (Vector2){ GetRandomValue(100, (int)windowX - 100), GetRandomValue(100, (int)windowY - 100) };
    boss.health = 5;
    boss.isActive = true;
    boss.speed = 100.0f;
    boss.sprite = LoadTexture("boss.png");
}

int main(void) {
    InitAudioDevice();
    music = LoadMusicStream("guns.ogg");
    click = LoadSound("click.ogg");
    eat = LoadSound("eat.ogg");
    hurt = LoadSound("hurt.ogg");
    explosion = LoadSound("bomb.wav");
    SetMusicVolume(music, 0.3f);
    PlayMusicStream(music);

    SetConfigFlags(FLAG_WINDOW_RESIZABLE);
    InitWindow((int)windowX, (int)windowY, "First window");

    plank = LoadTexture("plank.png");
    brick = LoadTexture("brick.png");
    grass = LoadTexture("grass.png");
    apple = LoadTexture("apple.png");
    bomb = LoadTexture("bomb.png");
    Texture2D player = LoadTexture("smile.png");
    Texture2D enemy = LoadTexture("enemy.png");

    SetTargetFPS(60);

    float px = windowX / 2;
    float py = windowY / 2;

    diff = Practise;
    difficultySelector(diff);
    LoadWorld(0);

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();
        UpdateMusicStream(music);

        windowX = (float)GetRenderWidth();
        windowY = (float)GetRenderHeight();

        if (IsKeyPressed(KEY_P)) {
            state = (state == Paused) ? GameState : Paused;
            PlaySound(click);
        }

        if (state == GameState) {
            // Boss spawn condition (example)
            if (numberOfCircles >= 5 && !boss.isActive) {
                InitBoss();
            }

            // Boss movement towards player
            if (boss.isActive) {
                Vector2 playerPos = {px, py};
                Vector2 dir = Vector2Normalize(Vector2Subtract(playerPos, boss.pos));
                boss.pos = Vector2Add(boss.pos, Vector2Scale(dir, boss.speed * dt));

                // Check attack proximity
                float distToBoss = Vector2Distance(playerPos, boss.pos);
                if (distToBoss <= 64 && IsKeyPressed(KEY_F)) {
                    boss.health--;
                    PlaySound(hurt);
                }

                if (boss.health <= 0) {
                    boss.isActive = false;
                    currentWorld++;
                    if (currentWorld < MAX_WORLDS) {
                        LoadWorld(currentWorld);
                    } else {
                        state = Menu;
                    }
                }
            }

            // Update player/enemy logic here as needed...

        }

        BeginDrawing();
        ClearBackground(SKYBLUE);

        if (state == GameState || state == Dead) {
            if (bg.id > 0) {
                DrawTexture(bg, 0, 0, WHITE);
            } else {
                ClearBackground(DARKGRAY);
            }

            // Draw apples
            for (int i = 0; i < apples.number; i++) {
                if (!apples.used[i]) {
                    DrawTexture(apple, (int)apples.x[i], (int)apples.y[i], WHITE);
                }
            }

            // Draw enemies
            for (int i = 0; i < enemies.number; i++) {
                DrawTexture(enemy, enemies.x[i], enemies.y[i], WHITE);
            }

            // Draw player
            DrawTexture(player, (int)px, (int)py, WHITE);

            // Draw boss if active
            if (boss.isActive) {
                DrawTexture(boss.sprite, (int)boss.pos.x, (int)boss.pos.y, WHITE);
            }

            DrawText(TextFormat("World: %i", currentWorld + 1), 10, 10, 20, DARKBLUE);
            DrawText(TextFormat("Score: %i", numberOfCircles), 10, 40, 20, WHITE);
            DrawText(TextFormat("Health: %i", game.health), 10, 70, 20, RED);
        }

        if (state == Menu) {
            ClearBackground(BLACK);
            DrawText("MENU - Press Enter to Play", windowX / 2 - 100, windowY / 2, 20, LIGHTGRAY);
            if (IsKeyPressed(KEY_ENTER)) {
                state = GameState;
                numberOfCircles = 0;
                px = windowX / 2;
                py = windowY / 2;
                game.health = 10;
                LoadWorld(0);
            }
        }

        if (state == Paused) {
            DrawText("PAUSED - Press P to Resume", windowX / 2 - 100, windowY / 2, 20, YELLOW);
        }

        EndDrawing();
    }

    // Cleanup
    UnloadTexture(player);
    UnloadTexture(enemy);
    if (boss.sprite.id > 0) UnloadTexture(boss.sprite);
    UnloadTexture(bg);
    UnloadMusicStream(music);
    CloseAudioDevice();
    CloseWindow();

    return 0;
}
