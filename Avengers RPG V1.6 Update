int main() {
    InitAudioDevice();
    music = LoadMusicStream("guns.ogg");
    click = LoadSound("click.ogg");
    eat = LoadSound("eat.ogg");
    hurt = LoadSound("hurt.ogg");
    explosion = LoadSound("bomb.wav");
    SetMusicVolume(music, 0.3f);
    PlayMusicStream(music);

    SetConfigFlags(FLAG_WINDOW_RESIZABLE);
    InitWindow(windowX, windowY, "First window");

    plank = LoadTexture("plank.png");
    brick = LoadTexture("brick.png");
    grass = LoadTexture("grass.png");
    apple = LoadTexture("apple.png");
    bomb = LoadTexture("bomb.png");
    Texture2D player = LoadTexture("smile.png");
    Texture2D enemy = LoadTexture("enemy.png");

    SetTargetFPS(60);

    float px = windowX / 2;
    float py = windowY / 2;
    float ex = GetRandomValue(0, windowX);
    float ey = GetRandomValue(0, windowY);

    int size = 64;
    float delay = 1.0f;

    diff = Practise;
    difficultySelector(diff);
    LoadWorld(0); // NEW: load world 0

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();
        UpdateMusicStream(music);
        Vector2 func = {
            sigmoid(ex / windowX - 1),
            sigmoid(ey / windowY - 1),
        };

        if (state == Game) {
            // Movement, collision, enemy updates...
            // (Keep your original logic here)

            // BOSS TRIGGER
            if (numberOfCircles >= 5 && !boss.isActive) {
                InitBoss();
            }
        }

        BeginDrawing();
        windowX = GetRenderWidth();
        windowY = GetRenderHeight();
        ClearBackground(SKYBLUE);

        if (state <= Dead) {
            // Draw background
            DrawTexture(bg.id > 0 ? bg : grass, 0, 0, WHITE); // fallback

            // Draw player, enemies, apples...

            // Draw BOSS
            if (boss.isActive) {
                Rectangle bossRect = { boss.pos.x, boss.pos.y, 128, 128 };
                SetShapesTexture(boss.sprite, (Rectangle){0, 0, 1024, 1024});
                DrawRectangleRec(bossRect, WHITE);

                float distToBoss = sqrt(pow(px - boss.pos.x, 2) + pow(py - boss.pos.y, 2));
                if (distToBoss <= 64 && IsKeyPressed(KEY_F)) {
                    boss.health--;
                    PlaySound(hurt);
                }

                if (boss.health <= 0) {
                    boss.isActive = false;
                    currentWorld++;
                    if (currentWorld < MAX_WORLDS) {
                        LoadWorld(currentWorld);
                    } else {
                        DrawText("YOU WIN!", windowX/2 - 100, windowY/2, 40, GREEN);
                        state = Menu;
                    }
                }
            }

            DrawText(TextFormat("World: %i", currentWorld + 1), 10, 150, 30, DARKBLUE);
            DrawText(TextFormat("Score: %i", numberOfCircles), 10, 10, 30, WHITE);
            DrawText(TextFormat("Health: %i", game.health), 10, 50, 30, RED);
        }

        if (state == Menu) {
            // Draw menu
        }
        if (state == Settings) {
            // Draw settings
        }

        EndDrawing();
    }

    // Cleanup
    UnloadTexture(player);
    UnloadTexture(enemy);
    UnloadTexture(boss.sprite);
    UnloadTexture(bg);
    UnloadMusicStream(music);
    CloseAudioDevice();
    CloseWindow();

    return 0;
}
