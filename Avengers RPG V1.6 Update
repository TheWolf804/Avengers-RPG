float sigmoid(float x) {
    return 1.0f / (1 + expf(-x));
}

void LoadWorld(int id) {
    currentWorld = id;

    switch (id) {
        case 0:
            bg = LoadTexture("world0_bg.png"); // NEW texture
            game.enemyTotal = 3;
            game.appleTotal = 5;
            break;
        default:
            bg = LoadTexture("default_bg.png");
            game.enemyTotal = 4;
            game.appleTotal = 3;
            break;
    }

    enemies.number = game.enemyTotal;
    for (int i = 0; i < enemies.number; i++) {
        enemies.x[i] = GetRandomValue(0, windowX);
        enemies.y[i] = GetRandomValue(0, windowY);
    }

    apples.number = game.appleTotal;
    for (int i = 0; i < apples.number; i++) {
        apples.x[i] = GetRandomValue(0, windowX);
        apples.y[i] = GetRandomValue(0, windowY);
        apples.used[i] = false;
    }

    bombs.number = 0;
    bombs.used[0] = false;
    boss.isActive = false;

    printf("World %d loaded\n", id);
}

void InitBoss() {
    boss.pos = (Vector2){ GetRandomValue(100, windowX - 100), GetRandomValue(100, windowY - 100) };
    boss.health = 5;
    boss.isActive = true;
    boss.sprite = LoadTexture("boss.png"); // Load from file
}

