#define MAX_BOMBS 0xFF
#define MAX_APPLES 0xFF
#define MAX_ENEMIES 0xFF
#define MAX_WORLDS 8
#define MAX_LEVEL 60

// Game states
typedef enum State {
    GameState,
    Dead,
    Menu,
    Settings,
    Submenu,
