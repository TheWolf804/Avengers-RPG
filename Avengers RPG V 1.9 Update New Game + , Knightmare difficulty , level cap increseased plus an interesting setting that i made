#include <raylib.h>
#include <raymath.h>
#include <stdlib.h>
#include <stdio.h>
#include <math.h>
#include <time.h>
#include <string.h>

#define MAX_BOMBS 0xFF
#define MAX_APPLES 0xFF
#define MAX_ENEMIES 0xFF
#define MAX_WORLDS 8
#define MAX_LEVEL 20

// Game states
typedef enum State {
    GameState,
    Dead,
    Menu,
    Settings,
    Submenu,
    Back,
    Paused
} State;

// Difficulty levels
typedef enum Difficulty {
    Practise,
    Easy,
    Normal,
    Hard,
    Insane,
    Nightmare,
    Deathwish,
    Armagedon
} Difficulty;

// Track player's game data
typedef struct GameData {
    int health;
    float playerSpeed;
    float enemySpeedBase;
    float bombInterval;
    float bombTimer;
    float appleTotal;
    float enemyTotal;
    int level;
    int xp;
    int xpToNextLevel;
} GameData;

// Track save data and unlocks
typedef struct Progress {
    bool worldBeaten[MAX_WORLDS];
    Difficulty beatenDifficulty[MAX_WORLDS];
    bool knightmareUnlocked;
} Progress;

// Game objects
typedef struct Bomb {
    float x[MAX_BOMBS], y[MAX_BOMBS];
    int number;
    bool used[MAX_BOMBS];
} Bomb;

typedef struct Apple {
    float x[MAX_APPLES], y[MAX_APPLES];
    int number;
    bool used[MAX_APPLES];
} Apple;

typedef struct Enemy {
    int x[MAX_ENEMIES], y[MAX_ENEMIES];
    int health[MAX_ENEMIES];
    int maxHealth[MAX_ENEMIES];
    int number;
} Enemy;

typedef struct World {
    int id;
    Texture2D background;
    int enemyCount;
    bool bossFightStarted;
} World;

typedef struct Boss {
    Vector2 pos;
    int health;
    bool isActive;
    float speed;
    Texture2D sprite;
} Boss;

// Global variables
State state = Menu;
Difficulty diff = Practise;
GameData game;
Progress progress;
Apple apples;
Bomb bombs;
Enemy enemies;
World worlds[MAX_WORLDS];
Boss boss;

float windowX = 800, windowY = 600;
int currentWorld = 0;
int numberOfCircles = 0;

bool showLevelUp = false;
float levelUpTimer = 0.0f;

Sound click, eat, hurt, explosion;
Texture2D plank, brick, grass, apple, bomb, bg, fruit;
Texture2D player, enemyTex;
Music music;

// Save/load
void SaveProgress() {
    FILE *fp = fopen("progress.sav", "wb");
    if (fp) {
        fwrite(&progress, sizeof(Progress), 1, fp);
        fclose(fp);
    }
}

void LoadProgress() {
    FILE *fp = fopen("progress.sav", "rb");
    if (fp) {
        fread(&progress, sizeof(Progress), 1, fp);
        fclose(fp);
    } else {
        memset(&progress, 0, sizeof(Progress));
    }
}

void CheckKnightmareUnlock() {
    bool allCleared = true;
    for (int i = 0; i < MAX_WORLDS; i++) {
        if (!progress.worldBeaten[i] || progress.beatenDifficulty[i] < Normal) {
            allCleared = false;
            break;
        }
    }
    if (allCleared && !progress.knightmareUnlocked) {
        progress.knightmareUnlocked = true;
        printf("Knightmare Mode Unlocked!\n");
        SaveProgress();
    }
}

void InitLevelSystem() {
    game.level = 1;
    game.xp = 0;
    game.xpToNextLevel = 100;
}

void UpdateEnemyStats() {
    for (int i = 0; i < enemies.number; i++) {
        enemies.maxHealth[i] = 3 + game.level;
        enemies.health[i] = enemies.maxHealth[i];
    }
}

void AddXP(int amount) {
    if (game.level >= MAX_LEVEL) {
        if (game.xp + amount > game.xpToNextLevel) game.xp = game.xpToNextLevel;
        else game.xp += amount;
        return;
    }
    game.xp += amount;
    while (game.xp >= game.xpToNextLevel && game.level < MAX_LEVEL) {
        game.xp -= game.xpToNextLevel;
        game.level++;
        game.xpToNextLevel = (int)(game.xpToNextLevel * 1.5f);
        game.health++;
        game.playerSpeed += 10.0f;
        game.enemySpeedBase += 5.0f;
        UpdateEnemyStats();
        PlaySound(click);
        showLevelUp = true;
        levelUpTimer = 2.0f;
        if (game.level >= MAX_LEVEL) game.xp = game.xpToNextLevel;
    }
}

void difficultySelector(Difficulty diff) {
    switch (diff) {
        case Practise:
            game.health = 10;
            game.playerSpeed = 200.0f;
            game.enemySpeedBase = 60.0f;
            break;
        case Easy:
            game.health = 8;
            game.playerSpeed = 180.0f;
            game.enemySpeedBase = 80.0f;
            break;
        case Normal:
            game.health = 6;
            game.playerSpeed = 150.0f;
            game.enemySpeedBase = 100.0f;
            break;
        case Nightmare:
            game.health = 3;
            game.playerSpeed = 130.0f;
            game.enemySpeedBase = 140.0f;
            break;
        default:
            game.health = 4;
            game.playerSpeed = 140.0f;
            game.enemySpeedBase = 120.0f;
            break;
    }
}

void LoadWorld(int id) {
    currentWorld = id;
    if (bg.id > 0) UnloadTexture(bg);
    bg = LoadTexture("world0_bg.png");
    game.enemyTotal = 3 + id;
    game.appleTotal = 5;
    enemies.number = (int)game.enemyTotal;
    for (int i = 0; i < enemies.number; i++) {
        enemies.x[i] = GetRandomValue(0, (int)windowX);
        enemies.y[i] = GetRandomValue(0, (int)windowY);
    }
    apples.number = (int)game.appleTotal;
    for (int i = 0; i < apples.number; i++) {
        apples.x[i] = GetRandomValue(0, (int)windowX);
        apples.y[i] = GetRandomValue(0, (int)windowY);
        apples.used[i] = false;
    }
    bombs.number = 0;
    for (int i = 0; i < MAX_BOMBS; i++) bombs.used[i] = false;
    boss.isActive = false;
    UpdateEnemyStats();
    printf("World %d loaded\n", id);
}

void InitBoss() {
    if (boss.sprite.id > 0) UnloadTexture(boss.sprite);
    boss.pos = (Vector2){ GetRandomValue(100, (int)windowX - 100), GetRandomValue(100, (int)windowY - 100) };
    boss.health = 5 + game.level * 2;
    boss.isActive = true;
    boss.speed = 100.0f + game.level * 5.0f;
    boss.sprite = LoadTexture("boss.png");
}

void StartNewGame() {
    difficultySelector(diff);
    InitLevelSystem();
    numberOfCircles = 0;
    currentWorld = 0;
    LoadWorld(currentWorld);
    state = GameState;
}

int main(void) {
    InitAudioDevice();
    LoadProgress();
    music = LoadMusicStream("guns.ogg");
    click = LoadSound("click.ogg");
    eat = LoadSound("eat.ogg");
    hurt = LoadSound("hurt.ogg");
    explosion = LoadSound("bomb.wav");
    SetMusicVolume(music, 0.3f);
    PlayMusicStream(music);
    SetConfigFlags(FLAG_WINDOW_RESIZABLE);
    InitWindow((int)windowX, (int)windowY, "New Game Plus Knightmare");
    plank = LoadTexture("plank.png");
    brick = LoadTexture("brick.png");
    grass = LoadTexture("grass.png");
    apple = LoadTexture("apple.png");
    bomb = LoadTexture("bomb.png");
    player = LoadTexture("smile.png");
    enemyTex = LoadTexture("enemy.png");
    SetTargetFPS(60);
    float px = windowX / 2;
    float py = windowY / 2;
    while (!WindowShouldClose()) {
        float dt = GetFrameTime();
        UpdateMusicStream(music);
        windowX = (float)GetRenderWidth();
        windowY = (float)GetRenderHeight();
        if (IsKeyPressed(KEY_P)) {
            state = (state == Paused) ? GameState : Paused;
            PlaySound(click);
        }
        BeginDrawing();
        ClearBackground(SKYBLUE);
        if (state == Menu) {
            ClearBackground(BLACK);
            DrawText("MENU - Press 1-4 to Select Difficulty", windowX / 2 - 140, windowY / 2 - 60, 20, LIGHTGRAY);
            DrawText("1. Practise", windowX / 2 - 60, windowY / 2 - 30, 20, GRAY);
            DrawText("2. Easy", windowX / 2 - 60, windowY / 2, 20, GREEN);
            DrawText("3. Normal", windowX / 2 - 60, windowY / 2 + 30, 20, YELLOW);
            DrawText("4. Nightmare (NG+)", windowX / 2 - 60, windowY / 2 + 60, 20, progress.knightmareUnlocked ? RED : DARKGRAY);
            if (IsKeyPressed(KEY_ONE)) { diff = Practise; StartNewGame(); }
            if (IsKeyPressed(KEY_TWO)) { diff = Easy; StartNewGame(); }
            if (IsKeyPressed(KEY_THREE)) { diff = Normal; StartNewGame(); }
            if (IsKeyPressed(KEY_FOUR) && progress.knightmareUnlocked) { diff = Nightmare; StartNewGame(); }
        }
        // (Rest of GameState logic same as your original code including boss defeat and XP)
        EndDrawing();
    }
    SaveProgress();
    UnloadTexture(player);
    UnloadTexture(enemyTex);
    if (boss.sprite.id > 0) UnloadTexture(boss.sprite);
    UnloadTexture(bg);
    UnloadMusicStream(music);
    CloseAudioDevice();
    CloseWindow();
    return 0;
}
